{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.21.0/.schema/devbox.schema.json",
  "packages": [
    "python@3.12",
    "uv@latest",
    "nodejs@24",
    "git@latest",
    "awscli2@latest",
    "jq@latest",
    "yq@latest",
    "just@latest",
    "gh@latest"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null"
    ],
    "scripts": {
      "test": [
        "uv run pytest"
      ],
      "lint": [
        "uv run ruff check . && uv run ruff format --check . && uv run mypy"
      ],
      "synth": [
        "npx cdk synth -c stage=dev"
      ]
    }
  }
}
